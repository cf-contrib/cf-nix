{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "cf-nix-cache",
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        "README.md",
        "packages/cf-nix-cache/README.md",
        "packages/cf-nix-cache-api/terraform/README.md",
        "packages/cf-nix-cache-api/terraform/variables.tf",
        "packages/cf-nix-cache-sdk/openapi/nix/cache/v1/cachev1.yaml",
        {
          "type": "toml",
          "path": "packages/cf-nix-cache-api/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='cf-nix-cache-api')].version"
        },
        {
          "type": "toml",
          "path": "packages/cf-nix-cache-sdk/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='cf-nix-cache-sdk')].version"
        }
      ]
    }
  }
}
