account_id     = "your-cf-account-id"
r2_bucket_name        = "nix-cache"

# Worker name (defaults to "cf-nix-cache"). Must be unique within the account.
# worker_name = "cf-nix-cache"

# Upload auth. Set at least one mechanism; see the root README's Authentication section.

# People: anyone with push access to this repo can upload with their GitHub token.
github_repository = "example-org/nix-cache-access"

# GitHub Actions: OIDC tokens from repos owned by this org/user, matching a rule.
# github_owner_id      = "100000001" # gh api orgs/<org> --jq .id
# github_oidc_audience = "https://cf-nix-cache.<your-subdomain>.workers.dev"
# github_oidc_rules = [
#   { repository_id = "200000002", ref = "refs/heads/main" },
# ]

# Legacy shared token (username x-auth-token). Leave unset once you've moved to the above.
# nix_token = "change-me"

# Ed25519 signing secret (<key-name>:<base64>) — generate with:
#   nix key generate-secret --key-name cache.example.org-1
nix_secret = "cache.example.org-1:..."
